# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies.
SESSION_SECRET="change-this-to-a-long-random-secret"

# INITIAL_ADMIN_EMAIL / INITIAL_ADMIN_PASSWORD: Optional initial administrator bootstrap credentials.
INITIAL_ADMIN_EMAIL="admin@ela-textiles.com"
INITIAL_ADMIN_PASSWORD=""
